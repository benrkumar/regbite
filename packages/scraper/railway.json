{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "NODE_ENV=development pnpm install && pnpm build --filter=@regbite/scraper"
  },
  "deploy": {
    "startCommand": "pnpm --filter=@regbite/scraper worker",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
