{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "NODE_ENV=development pnpm install && pnpm build --filter=@regbite/admin"
  },
  "deploy": {
    "startCommand": "HOSTNAME=0.0.0.0 apps/admin/node_modules/.bin/next start apps/admin",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
